{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment app topology",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "apps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "appId",
          "projectPath",
          "role",
          "healthPath",
          "deployOrder"
        ],
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "projectPath": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Role driving the port-range scheme (web, api, ...). Roles and their ranges are defined in infra/deployment/roles.json (ADR-0004) — consumers add custom roles there without touching Python."
          },
          "kind": {
            "type": "string",
            "enum": ["service", "job"],
            "description": "Deploy kind (ADR-0003): service apps are rollout Deployments; job apps are wait-for-completion k8s Jobs (e.g. db-bootstrap, per-app migration jobs)."
          },
          "runtime": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Resolved per-app runtime (dotnet, node, python, go, ...) — filled at scaffold time (ADR-0003). Empty/absent in the shipped template."
          },
          "artifactName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.zip$"
          },
          "healthPath": {
            "type": "string",
            "pattern": "^/"
          },
          "deployOrder": {
            "type": "integer",
            "minimum": 0
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
