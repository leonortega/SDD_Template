[TEMPLATE]
GITEA_ACCESS_TOKEN=replace-with-gitea-api-token

# Token for the SHARED Gitea MCP HTTP server (service `gitea-mcp` in
# infra/gitea/compose.yml, container `agentic-gitea-mcp`). The server uses this
# token to call the Gitea API and to validate client Bearer headers.
#
# `environment-lab setup-lab` (install-gitea-mcp step) syncs this file from
# .codex/client-tools.local.json (gitea.apiToken) automatically, and re-creates
# the container when the token changes. All MCP clients (VS Code, Cline, CLI)
# connect to the same instance at http://localhost:8123/mcp — at most one
# gitea-mcp container runs at a time.
