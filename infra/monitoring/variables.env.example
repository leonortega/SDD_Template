# Monitoring environment template.
#
# Copy this file to infra/monitoring/variables.env. Keep real values only in
# ignored .env files.

# ---------------------------------------------------------------------------
# Seq and Grafana
# ---------------------------------------------------------------------------
SEQ_URL=http://localhost:5341

# Docker Desktop pods send live Serilog events directly to local Seq through
# the host gateway. Keep localhost for host/container scripts; use this value
# for app pods.
DOCKER_APP_SEQ_URL=http://host.docker.internal:5341

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
GRAFANA_HEALTH_ALERT_FOR=2m
SEQ_ERROR_ALERT_WINDOW=1m
SEQ_ERROR_ALERT_THRESHOLD=0

# ---------------------------------------------------------------------------
# Grafana MCP authentication
# ---------------------------------------------------------------------------
# The lab publishes Grafana on host port 3001 (container port 3000).
GRAFANA_URL=http://localhost:3001
# Auto-provisioned by `environment-lab provision-grafana-token` (run as step 9a
# of setup-lab). Leave empty — setup mints a real service-account token via the
# Grafana API (admin:admin) and writes it here so the Grafana MCP registers
# with credentials instead of a placeholder. Override manually if needed.
GRAFANA_SERVICE_ACCOUNT_TOKEN=

