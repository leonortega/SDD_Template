# Monitoring environment template.
#
# Copy this file to infra/monitoring/variables.env. Keep real values only in
# ignored .env files.

# ---------------------------------------------------------------------------
# Seq and Grafana
# ---------------------------------------------------------------------------
SEQ_URL=http://localhost:5341

# Docker Desktop pods send live Serilog events directly to local Seq through
# the host gateway. Keep localhost for host/container scripts; use this value
# for app pods.
DOCKER_APP_SEQ_URL=http://host.docker.internal:5341

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
GRAFANA_HEALTH_ALERT_FOR=2m
SEQ_ERROR_ALERT_WINDOW=1m
SEQ_ERROR_ALERT_THRESHOLD=0

