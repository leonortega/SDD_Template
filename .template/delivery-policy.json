{
  "quality": {
    "gates": [
      {
        "id": "json-validation",
        "required": true
      },
      {
        "id": "gitleaks",
        "required": true
      },
      {
        "id": "semgrep",
        "required": true
      },
      {
        "id": "trivy",
        "required": true
      },
      {
        "id": "checkov",
        "required": true
      },
      {
        "id": "stack-tests",
        "required": false
      },
      {
        "id": "agent-reviewed-label",
        "required": true
      }
    ]
  },
  "agentOptimization": {
    "maxAutonomousIterations": 20,
    "maxToolRetries": 2,
    "promptCache": {
      "enabled": true,
      "staticContextFirst": true,
      "dynamicRuntimeContextLast": true,
      "trackCachedTokens": true
    },
    "contextTiers": {
      "enabled": true,
      "tiers": [
        {
          "id": 1,
          "name": "STABLE_PREFIX",
          "description": "Repo identity, mandatory rules, core policy — never changes per turn. Cached once per session.",
          "files": [
            "AGENTS.md",
            ".agents/skills/_shared/repo-startup.md",
            ".template/delivery-policy.json",
            ".agents/mcp-instructions.md",
            "docs/conventions/context-management.md"
          ],
          "cacheStrategy": "session",
          "breakpointAfter": true
        },
        {
          "id": 2,
          "name": "SEMI_STABLE",
          "description": "Core delivery contract and startup sequence — loaded every stage, changes rarely.",
          "files": [
            ".agents/skills/_shared/delivery-contract.md",
            ".agents/skills/_shared/delivery-contract-core.md",
            ".agents/skills/_shared/skill-startup.md",
            ".agents/skills/_shared/delivery-contract-format.md",
            ".agents/skills/_shared/test-requirements.md",
            ".template/project-profile.json",
            "knowledge/README.md"
          ],
          "cacheStrategy": "session",
          "breakpointAfter": true
        },
        {
          "id": 3,
          "name": "STAGE_SPECIFIC",
          "description": "Stage-specific delivery contracts and API helpers — changes per workflow stage.",
          "files": [
            ".agents/skills/_shared/delivery-contract-ticket.md",
            ".agents/skills/_shared/delivery-contract-review.md",
            ".agents/skills/_shared/delivery-contract-qa.md",
            ".agents/skills/_shared/delivery-contract-deploy.md",
            ".agents/skills/_shared/delivery-contract-parallel.md",
            ".agents/skills/_shared/api-helpers.md"
          ],
          "cacheStrategy": "stage",
          "breakpointAfter": true
        },
        {
          "id": 4,
          "name": "DYNAMIC",
          "description": "Every-turn data: user message, conversation history, tool outputs, live state. Never cached.",
          "files": [],
          "cacheStrategy": "never",
          "breakpointAfter": false
        }
      ]
    }
  }
}
