{
  "mcpServers": {
    "gitea": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "docker.gitea.com/gitea-mcp-server",
        "--host",
        "http://localhost:3000"
      ],
      "env": {
        "GITEA_ACCESS_TOKEN": "${GITEA_ACCESS_TOKEN}"
      },
      "description": "Official Gitea MCP — repos, issues, PRs, Actions"
    },
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "description": "Official Grafana MCP — dashboards, queries, alerts, incidents"
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "env": {
        "KUBECONFIG": "${env:USERPROFILE}\\.kube\\config"
      },
      "description": "Native Go K8s MCP — pods, deployments, logs, helm"
    },
    "openproject": {
      "command": "npx",
      "args": [
        "-y",
        "openproject-mcp"
      ],
      "env": {
        "OPENPROJECT_URL": "http://localhost:8080",
        "OPENPROJECT_API_KEY": "${OPENPROJECT_API_KEY}"
      },
      "description": "Community OpenProject MCP — work packages, projects, time entries"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "description": "Official Playwright MCP (Microsoft) — browser automation, navigation, snapshots, element interaction"
    }
  }
}
